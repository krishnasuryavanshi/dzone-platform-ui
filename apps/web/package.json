{
  "name": "@dzone/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test:unit": "node -e \"if(process.env.SKIP_UNIT_TESTS==='true'){console.log('Unit tests skipped');process.exit(0)}\" || vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "node -e \"if(process.env.SKIP_E2E_TESTS==='true'){console.log('E2E tests skipped');process.exit(0)}\" || playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test": "pnpm test:unit && pnpm test:e2e",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@dzone/shared-auth": "workspace:*",
    "@dzone/shared-feature-flags": "workspace:*",
    "@dzone/shared-i18n": "workspace:*",
    "@dzone/shared-lib": "workspace:*",
    "@dzone/shared-logger": "workspace:*",
    "@dzone/shared-store": "workspace:*",
    "@dzone/shared-styles": "workspace:*",
    "@dzone/shared-ui": "workspace:*",
    "@tanstack/react-query": "^5.75.5",
    "antd": "^5.25.1",
    "axios": "^1.9.0",
    "dayjs": "^1.11.13",
    "dompurify": "^3.2.4",
    "i18next": "^25.2.1",
    "immer": "^10.1.1",
    "libphonenumber-js": "^1.12.38",
    "lodash-es": "^4.17.21",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.4.1",
    "react-router": "^7.6.1",
    "zod": "^3.25.17",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/dompurify": "^3.2.0",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.28.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "msw": "^2.9.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.1"
  }
}
